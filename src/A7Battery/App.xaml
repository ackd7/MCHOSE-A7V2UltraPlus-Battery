<Application x:Class="A7Battery.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 控件基础样式：主色跟随 miuix 蓝 -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="LightBlue"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- miuix lightColorScheme 语义画刷默认值（照搬 compose-miuix-ui/miuix 的 Colors.kt）。
                 动态/静态取色时由 ThemeService 在 miuix 骨架上覆盖主色系。 -->
            <SolidColorBrush x:Key="A7.Primary" Color="#3482FF"/>
            <SolidColorBrush x:Key="A7.OnPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="A7.PrimaryContainer" Color="#5D9BFF"/>
            <SolidColorBrush x:Key="A7.OnPrimaryContainer" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="A7.Secondary" Color="#E6E6E6"/>
            <SolidColorBrush x:Key="A7.OnSecondary" Color="#303030"/>
            <SolidColorBrush x:Key="A7.SecondaryContainer" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="A7.OnSecondaryContainer" Color="#A9A9A9"/>
            <SolidColorBrush x:Key="A7.Tertiary" Color="#EAF2FF"/>
            <SolidColorBrush x:Key="A7.OnTertiary" Color="#3482FF"/>
            <SolidColorBrush x:Key="A7.Background" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="A7.OnBackground" Color="#000000"/>
            <SolidColorBrush x:Key="A7.Surface" Color="#F7F7F7"/>
            <SolidColorBrush x:Key="A7.OnSurface" Color="#000000"/>
            <SolidColorBrush x:Key="A7.SurfaceVariant" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="A7.OnSurfaceVariant" Color="#8C93B0"/>
            <SolidColorBrush x:Key="A7.SurfaceContainer" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="A7.SurfaceContainerLow" Color="#F7F7F7"/>
            <SolidColorBrush x:Key="A7.SurfaceContainerHigh" Color="#E8E8E8"/>
            <SolidColorBrush x:Key="A7.Divider" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="A7.Outline" Color="#D9D9D9"/>
            <SolidColorBrush x:Key="A7.OutlineVariant" Color="#E8E8E8"/>
            <SolidColorBrush x:Key="A7.Error" Color="#E94634"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
