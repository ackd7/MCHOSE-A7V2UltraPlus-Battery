<Window x:Class="A7Battery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="A7 电量助手" Height="700" Width="470"
        MinHeight="560" MinWidth="410"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource A7.Background}"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="Roboto, Microsoft YaHei UI"
        TextElement.Foreground="{DynamicResource A7.OnSurface}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13">

    <Window.Resources>
        <!-- 档位数字按钮（轻量） -->
        <Style x:Key="StageNumBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource A7.OnSurfaceVariant}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="9" Background="{TemplateBinding Background}" HorizontalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DPI chip 内的数值输入 -->
        <Style x:Key="DpiBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource A7.OnSurface}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="InputScope" Value="Number"/>
        </Style>

        <!-- 自绘窗口按钮 -->
        <Style x:Key="WindowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource A7.OnSurfaceVariant}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource A7.SurfaceVariant}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowBtnClose" TargetType="Button" BasedOn="{StaticResource WindowBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 回报率分段按钮 -->
        <Style x:Key="RateChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource A7.SurfaceContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource A7.OnSurfaceVariant}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- 内容外框：窗口圆角由 Windows 11 DWM 原生处理（见 App 中的 DwmSetWindowAttribute），保证 4K 清晰 -->
    <Border x:Name="WindowFrame" Background="{DynamicResource A7.Background}" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶栏 (自绘标题栏，可拖动) -->
            <Border x:Name="TitleBar" Grid.Row="0" Height="52"
                    Background="{DynamicResource A7.Surface}"
                    BorderBrush="{DynamicResource A7.Divider}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="BatteryCharging" Width="20" Height="20"
                                                 Foreground="{DynamicResource A7.Primary}"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="A7 电量助手" FontSize="15" FontWeight="Medium"
                                   Foreground="{DynamicResource A7.OnSurface}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 自绘窗口按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MinimizeBtn" Width="34" Height="34" ToolTip="最小化"
                                Click="MinimizeBtn_Click" Style="{StaticResource WindowBtn}">
                            <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="MaximizeBtn" Width="34" Height="34" ToolTip="最大化/还原"
                                Click="MaximizeBtn_Click" Style="{StaticResource WindowBtn}">
                            <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="CloseBtn" Width="34" Height="34" ToolTip="关闭"
                                Click="CloseBtn_Click" Style="{StaticResource WindowBtnClose}">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,24">

                <!-- 主电量卡片 -->
                <materialDesign:Card x:Name="BatteryCard" UniformCornerRadius="24" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Mouse" Width="18" Height="18"
                                                         Foreground="{DynamicResource A7.Primary}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="迈从 A7 V2 Ultra+" FontSize="15" FontWeight="Medium"
                                           Foreground="{DynamicResource A7.OnSurface}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#9AA5B4" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText" Text="检测中" FontSize="12"
                                           Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,10" Height="112">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PercentText" Text="--" FontSize="78" FontWeight="Light"
                                           Foreground="{DynamicResource A7.Primary}" LineHeight="92"/>
                                <TextBlock Text="%" FontSize="26" FontWeight="Light"
                                           Foreground="{DynamicResource A7.Primary}"
                                           VerticalAlignment="Bottom" Margin="2,0,0,16"/>
                            </StackPanel>

                            <!-- 电池图形 -->
                            <Grid Grid.Column="1" Width="96" Height="96" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Border x:Name="BatteryOutline" Width="72" Height="38" CornerRadius="8"
                                        BorderBrush="{DynamicResource A7.Primary}" BorderThickness="3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="64" Height="30" CornerRadius="4"
                                        Background="{DynamicResource A7.SurfaceVariant}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                    <Border x:Name="BatteryFill" Width="0" Height="30"
                                            Background="{DynamicResource A7.Primary}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <Rectangle x:Name="BatteryCap" Width="5" Height="15" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource A7.Primary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <materialDesign:PackIcon x:Name="BoltIcon" Kind="LightningBolt" Width="26" Height="26"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Visibility="Collapsed"/>
                            </Grid>
                        </Grid>

                        <ProgressBar x:Name="BatteryBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource A7.Primary}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ChargeText" Text="等待读取数据…" FontSize="12" Margin="0,10,0,0"
                                   Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 设备信息卡片 -->
                <materialDesign:Card x:Name="DeviceCard" UniformCornerRadius="24" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="17" Height="17"
                                                     Foreground="{DynamicResource A7.Primary}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="设备信息" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource A7.OnSurface}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="连接方式" FontSize="13" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                            <TextBlock x:Name="ModeText" Text="--" FontSize="13" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource A7.OnSurface}"/>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="设备通道" FontSize="13" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                            <TextBlock x:Name="DeviceText" Text="--" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource A7.OnSurface}"
                                       MaxWidth="230" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="更新时间" FontSize="13" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                            <TextBlock x:Name="UpdateText" Text="--" FontSize="13" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource A7.OnSurface}"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 设置卡片 -->
                <materialDesign:Card x:Name="SettingsCard" UniformCornerRadius="24" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="SettingsOutline" Width="17" Height="17"
                                                     Foreground="{DynamicResource A7.Primary}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="设置" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource A7.OnSurface}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="刷新间隔" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource A7.OnSurface}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="Btn15" Content="15s" Tag="15" Margin="0,0,6,0"
                                        Padding="12,4,12,4" FontSize="12" Click="Interval_Click"/>
                                <Button x:Name="Btn30" Content="30s" Tag="30" Margin="0,0,6,0"
                                        Padding="12,4,12,4" FontSize="12" Click="Interval_Click"/>
                                <Button x:Name="Btn90" Content="90s" Tag="90"
                                        Padding="12,4,12,4" FontSize="12" Click="Interval_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="开机自启" FontSize="13" Foreground="{DynamicResource A7.OnSurface}"/>
                                <TextBlock Text="登录 Windows 后自动在托盘运行" FontSize="11"
                                           Foreground="{DynamicResource A7.OnSurfaceVariant}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoStartSwitch"
                                      HorizontalAlignment="Right" Checked="AutoStart_Toggled" Unchecked="AutoStart_Toggled"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="托盘显示电量" FontSize="13" Foreground="{DynamicResource A7.OnSurface}"/>
                                <TextBlock Text="在任务栏图标上直接显示百分比" FontSize="11"
                                           Foreground="{DynamicResource A7.OnSurfaceVariant}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="TrayPercentSwitch"
                                      IsChecked="True" HorizontalAlignment="Right"
                                      Checked="TrayPercent_Toggled" Unchecked="TrayPercent_Toggled"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="启动时检查更新" FontSize="13" Foreground="{DynamicResource A7.OnSurface}"/>
                                <TextBlock Text="每天首次启动时检查 GitHub 新版本" FontSize="11"
                                           Foreground="{DynamicResource A7.OnSurfaceVariant}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="CheckUpdatesSwitch"
                                      IsChecked="True" HorizontalAlignment="Right"
                                      Checked="CheckUpdates_Toggled" Unchecked="CheckUpdates_Toggled"/>
                        </Grid>

                        <Button x:Name="RefreshBtn" Content="立即刷新" HorizontalAlignment="Stretch" Click="Refresh_Click"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 鼠标设置卡片 -->
                <materialDesign:Card x:Name="MouseCard" UniformCornerRadius="24" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MouseVariant" Width="17" Height="17"
                                                         Foreground="{DynamicResource A7.Primary}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="鼠标设置 · DPI / 回报率" FontSize="15" FontWeight="Medium"
                                           Foreground="{DynamicResource A7.OnSurface}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="ReadMouseBtn" Content="读取当前" HorizontalAlignment="Right"
                                    Padding="12,4,12,4" FontSize="12" Click="ReadMouse_Click"/>
                        </Grid>

                        <TextBlock x:Name="MouseStatusText" Text="点击“读取当前”获取设备现有配置"
                                   FontSize="11" Foreground="{DynamicResource A7.OnSurfaceVariant}"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <!-- DPI 档位：6 个精致 chip，点档位号设为当前 -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="DPI 档位" FontSize="12" Foreground="{DynamicResource A7.OnSurfaceVariant}" VerticalAlignment="Center"/>
                            <TextBlock Text="点档位号设为当前 · 直接改数值" FontSize="10" Foreground="{DynamicResource A7.OnSurfaceVariant}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <UniformGrid Rows="1" Columns="6" Margin="0,0,0,10">
                            <Border x:Name="DpiChip0" Background="{DynamicResource A7.SurfaceContainer}" CornerRadius="12" Margin="0,0,3,0" Padding="2,6">
                                <StackPanel>
                                    <Button x:Name="StageBtn0" Content="1" Tag="0" Style="{StaticResource StageNumBtn}" Click="DpiStage_Click"/>
                                    <TextBox x:Name="Dpi0" Text="400" Style="{StaticResource DpiBox}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DpiChip1" Background="{DynamicResource A7.SurfaceContainer}" CornerRadius="12" Margin="0,0,3,0" Padding="2,6">
                                <StackPanel>
                                    <Button x:Name="StageBtn1" Content="2" Tag="1" Style="{StaticResource StageNumBtn}" Click="DpiStage_Click"/>
                                    <TextBox x:Name="Dpi1" Text="800" Style="{StaticResource DpiBox}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DpiChip2" Background="{DynamicResource A7.SurfaceContainer}" CornerRadius="12" Margin="0,0,3,0" Padding="2,6">
                                <StackPanel>
                                    <Button x:Name="StageBtn2" Content="3" Tag="2" Style="{StaticResource StageNumBtn}" Click="DpiStage_Click"/>
                                    <TextBox x:Name="Dpi2" Text="1600" Style="{StaticResource DpiBox}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DpiChip3" Background="{DynamicResource A7.SurfaceContainer}" CornerRadius="12" Margin="0,0,3,0" Padding="2,6">
                                <StackPanel>
                                    <Button x:Name="StageBtn3" Content="4" Tag="3" Style="{StaticResource StageNumBtn}" Click="DpiStage_Click"/>
                                    <TextBox x:Name="Dpi3" Text="3200" Style="{StaticResource DpiBox}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DpiChip4" Background="{DynamicResource A7.SurfaceContainer}" CornerRadius="12" Margin="0,0,3,0" Padding="2,6">
                                <StackPanel>
                                    <Button x:Name="StageBtn4" Content="5" Tag="4" Style="{StaticResource StageNumBtn}" Click="DpiStage_Click"/>
                                    <TextBox x:Name="Dpi4" Text="6400" Style="{StaticResource DpiBox}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DpiChip5" Background="{DynamicResource A7.SurfaceContainer}" CornerRadius="12" Margin="0,0,0,0" Padding="2,6">
                                <StackPanel>
                                    <Button x:Name="StageBtn5" Content="6" Tag="5" Style="{StaticResource StageNumBtn}" Click="DpiStage_Click"/>
                                    <TextBox x:Name="Dpi5" Text="26000" Style="{StaticResource DpiBox}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="当前生效档位" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                            <TextBlock x:Name="ActiveStageText" Text="档位 3 · 1600 DPI" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource A7.Primary}" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- 回报率：滑条档位 -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="回报率 (Polling Rate)" FontSize="12" Foreground="{DynamicResource A7.OnSurfaceVariant}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RateValueText" Text="1000 Hz" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource A7.Primary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Background="{DynamicResource A7.SurfaceContainer}" CornerRadius="14" Padding="14,8,14,6" Margin="0,2,0,12">
                            <StackPanel>
                                <Slider x:Name="RateSlider" Minimum="0" Maximum="5" Value="2"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="1"
                                        Height="28" ValueChanged="RateSlider_ValueChanged"/>
                                <Grid Margin="0,-2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="125" FontSize="9" TextAlignment="Center" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                                    <TextBlock Grid.Column="1" Text="500" FontSize="9" TextAlignment="Center" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                                    <TextBlock Grid.Column="2" Text="1K" FontSize="9" TextAlignment="Center" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                                    <TextBlock Grid.Column="3" Text="2K" FontSize="9" TextAlignment="Center" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                                    <TextBlock Grid.Column="4" Text="4K" FontSize="9" TextAlignment="Center" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                                    <TextBlock Grid.Column="5" Text="8K" FontSize="9" TextAlignment="Center" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Button x:Name="ApplyDpiBtn" Content="应用 DPI" HorizontalAlignment="Left"
                                    Padding="16,4,16,4" FontSize="12" Click="ApplyDpi_Click"/>
                            <Button x:Name="ApplyRateBtn" Content="应用回报率" HorizontalAlignment="Right"
                                    Padding="16,4,16,4" FontSize="12" Click="ApplyRate_Click"/>
                        </Grid>

                        <TextBlock Text="设置写入鼠标板载配置，切换连接或重启后依然生效。"
                                   FontSize="10" Foreground="{DynamicResource A7.OnSurfaceVariant}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 主题取色卡片 -->
                <materialDesign:Card x:Name="ThemeCard" UniformCornerRadius="24" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="Palette" Width="17" Height="17"
                                                     Foreground="{DynamicResource A7.Primary}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="主题取色 · Material You" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource A7.OnSurface}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="参考 dots-hyprland 的动态配色：从种子色生成整套 MD3 调色板"
                                   FontSize="10" Foreground="{DynamicResource A7.OnSurfaceVariant}"
                                   TextWrapping="Wrap" Margin="25,0,0,12"/>

                        <!-- 模式切换 -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ThemeStaticBtn" Content="静态取色" Click="ThemeStatic_Click"
                                        Padding="14,5,14,5" FontSize="12" Margin="0,0,6,0"/>
                                <Button x:Name="ThemeDynamicBtn" Content="动态取色" Click="ThemeDynamic_Click"
                                        Padding="14,5,14,5" FontSize="12"/>
                            </StackPanel>
                            <TextBlock x:Name="ThemeModeLabel" Text="" FontSize="11" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                        </Grid>

                        <!-- 静态：预设色板 -->
                        <StackPanel x:Name="StaticPalettePanel">
                            <TextBlock Text="预设种子色" FontSize="12" Foreground="{DynamicResource A7.OnSurfaceVariant}" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="PresetSwatches" Margin="0,0,0,6"/>
                        </StackPanel>

                        <!-- 配色风格（MaterialKolor PaletteStyle） -->
                        <Grid Margin="0,4,0,10">
                            <TextBlock Text="配色风格" FontSize="12" Foreground="{DynamicResource A7.OnSurfaceVariant}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="PaletteStyleCombo" Width="130" HorizontalAlignment="Right"
                                      SelectionChanged="PaletteStyleCombo_SelectionChanged">
                                <ComboBoxItem Content="柔和 TonalSpot" Tag="0"/>
                                <ComboBoxItem Content="鲜艳 Vibrant" Tag="1"/>
                                <ComboBoxItem Content="表现 Expressive" Tag="2"/>
                                <ComboBoxItem Content="中性 Neutral" Tag="3"/>
                                <ComboBoxItem Content="单色 Monochrome" Tag="4"/>
                            </ComboBox>
                        </Grid>

                        <!-- 动态：系统强调色 -->
                        <StackPanel x:Name="DynamicPalettePanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="AccentSwatch" Width="26" Height="26" CornerRadius="13"
                                            Background="{DynamicResource A7.Primary}" BorderBrush="{DynamicResource A7.OutlineVariant}"
                                            BorderThickness="1" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="跟随桌面壁纸颜色" FontSize="12" Foreground="{DynamicResource A7.OnSurface}"/>
                                        <TextBlock x:Name="AccentHexText" Text="" FontSize="11" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="RefreshAccentBtn" Content="重新取色" Click="RefreshAccent_Click"
                                        HorizontalAlignment="Right" Padding="12,4,12,4" FontSize="12"/>
                            </Grid>
                            <TextBlock Text="从当前壁纸提取主色（Wallpaper Engine 等动态壁纸同样适用）。换壁纸后点“重新取色”即可。"
                                       FontSize="10" Foreground="{DynamicResource A7.OnSurfaceVariant}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 当前色板预览 -->
                        <Border Background="{DynamicResource A7.SurfaceContainer}" CornerRadius="12" Padding="10,8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="当前调色板" FontSize="11" Foreground="{DynamicResource A7.OnSurfaceVariant}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="SwatchPrimary" Width="30" Height="30" CornerRadius="8" Margin="0,0,6,0"/>
                                    <Border x:Name="SwatchSecondary" Width="30" Height="30" CornerRadius="8" Margin="0,0,6,0"/>
                                    <Border x:Name="SwatchTertiary" Width="30" Height="30" CornerRadius="8" Margin="0,0,6,0"/>
                                    <Border x:Name="SwatchContainer" Width="30" Height="30" CornerRadius="8" Margin="0,0,6,0"/>
                                    <Border x:Name="SwatchSurface" Width="30" Height="30" CornerRadius="8"
                                            BorderBrush="{DynamicResource A7.OutlineVariant}" BorderThickness="1"/>
                                </StackPanel>
                                <TextBlock x:Name="PaletteHexText" Text="" FontSize="10" Foreground="{DynamicResource A7.OnSurfaceVariant}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 版本与更新 -->
                <StackPanel Orientation="Horizontal" Margin="4,2,0,0">
                    <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11"
                               Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                    <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
                    <TextBlock x:Name="UpdateStatusText" Text="" FontSize="11" Cursor="Hand"
                               Foreground="{DynamicResource A7.Primary}"
                               MouseLeftButtonUp="UpdateStatus_Click"/>
                </StackPanel>

                <TextBlock Text="关闭窗口后程序继续在任务栏托盘运行 · 左键托盘图标可再次打开"
                           FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource A7.OnSurfaceVariant}"/>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Border>
</Window>
