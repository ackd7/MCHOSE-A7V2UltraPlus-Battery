<Window x:Class="A7Battery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A7 电量助手" Height="660" Width="460"
        MinHeight="520" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <!-- 卡片样式 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E8ECF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1F2937" BlurRadius="14" ShadowDepth="2" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关样式（CheckBox 伪装成 ToggleSwitch） -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="10" Background="#C9D2DC" Height="20"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1" Opacity="0.25"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4CC2FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 间隔按钮 -->
        <Style x:Key="IntervalBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,5,14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F3F5F8"/>
            <Setter Property="Foreground" Value="#5A6678"/>
            <Setter Property="BorderBrush" Value="#E2E7EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4CC2FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36B2EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Height="50" Background="White" BorderBrush="#ECEFF3" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="⚡" FontSize="18" Foreground="#4CC2FF" Margin="0,0,8,0" FontFamily="Segoe UI Emoji"/>
                <TextBlock Text="A7 电量助手" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,24">

                <!-- 主电量卡片 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="迈从 A7 V2 Ultra+" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9AA5B4" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText" Text="检测中" FontSize="12" Foreground="#8A94A3"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,20,0,8" Height="108">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PercentText" Text="--" FontSize="76" FontWeight="Light"
                                           Foreground="#4CC2FF" LineHeight="90"/>
                                <TextBlock Text="%" FontSize="26" FontWeight="Light" Foreground="#4CC2FF"
                                           VerticalAlignment="Bottom" Margin="2,0,0,16"/>
                            </StackPanel>

                            <!-- 电池图形 -->
                            <Grid Grid.Column="1" Width="96" Height="96" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Border x:Name="BatteryOutline" Width="72" Height="38" CornerRadius="7"
                                        BorderBrush="#4CC2FF" BorderThickness="3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="64" Height="30" CornerRadius="3" Background="#EEF1F5"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                    <Border x:Name="BatteryFill" Width="0" Height="30" Background="#4CC2FF"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <Rectangle x:Name="BatteryCap" Width="5" Height="15" RadiusX="2" RadiusY="2"
                                           Fill="#4CC2FF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="BoltIcon" Text="⚡" FontFamily="Segoe UI Emoji" FontSize="24"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>

                        <ProgressBar x:Name="BatteryBar" Height="7" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#4CC2FF" Background="#EEF1F5" BorderThickness="0"/>
                        <TextBlock x:Name="ChargeText" Text="等待读取数据…" FontSize="12" Foreground="#8A94A3" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 设备信息卡片 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="设备信息" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="连接方式" FontSize="13" Foreground="#7A8698"/>
                            <TextBlock x:Name="ModeText" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="设备通道" FontSize="13" Foreground="#7A8698"/>
                            <TextBlock x:Name="DeviceText" Text="--" FontSize="12" Foreground="#334155" HorizontalAlignment="Right"
                                       MaxWidth="230" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="更新时间" FontSize="13" Foreground="#7A8698"/>
                            <TextBlock x:Name="UpdateText" Text="--" FontSize="13" Foreground="#334155" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 设置卡片 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="刷新间隔" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="Btn15" Content="15s" Tag="15" Style="{StaticResource IntervalBtn}" Margin="0,0,6,0" Click="Interval_Click"/>
                                <Button x:Name="Btn30" Content="30s" Tag="30" Style="{StaticResource IntervalBtn}" Margin="0,0,6,0" Click="Interval_Click"/>
                                <Button x:Name="Btn90" Content="90s" Tag="90" Style="{StaticResource IntervalBtn}" Click="Interval_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="开机自启" FontSize="13" Foreground="#334155"/>
                                <TextBlock Text="登录 Windows 后自动在托盘运行" FontSize="11" Foreground="#9AA5B4" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      Checked="AutoStart_Toggled" Unchecked="AutoStart_Toggled"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="托盘显示电量" FontSize="13" Foreground="#334155"/>
                                <TextBlock Text="在任务栏图标上直接显示百分比" FontSize="11" Foreground="#9AA5B4" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="TrayPercentSwitch" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right"
                                      Checked="TrayPercent_Toggled" Unchecked="TrayPercent_Toggled"/>
                        </Grid>

                        <Button x:Name="RefreshBtn" Content="立即刷新" Style="{StaticResource PrimaryBtn}" Click="Refresh_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="关闭窗口后程序继续在任务栏托盘运行 · 左键托盘图标可再次打开"
                           FontSize="11" Foreground="#9AA5B4" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
